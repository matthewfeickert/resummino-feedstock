From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Fri, 2 Oct 2026 01:13:42 -0600
Subject: [PATCH] Fix the scalar SIMD vector of Fastor for std::complex<double>

Without SSE, as on aarch64, the vendored Fastor uses its scalar
implementation of SIMDVector for std::complex<double>, which does not
compile:

* There is no vector_setter overload for it. The overload exists, but
  is commented out and declares its ABI template parameter as an int
  and not as a type.
* The unary minus constructs the vector from (0,0), which is ambiguous
  between the constructor from a pointer and a bool and the one from
  the real and imaginary parts.

With SSE, as on x86_64, the SSE implementation is used and neither is
compiled.
---
 .../include/Fastor/simd_vector/simd_vector_common.h  | 12 ++++++------
 .../Fastor/simd_vector/simd_vector_complex_scalar.h  |  2 +-
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/external/include/Fastor/simd_vector/simd_vector_common.h b/external/include/Fastor/simd_vector/simd_vector_common.h
index 908c677..0bbbe3b 100644
--- a/external/include/Fastor/simd_vector/simd_vector_common.h
+++ b/external/include/Fastor/simd_vector/simd_vector_common.h
@@ -223,12 +223,12 @@ FASTOR_INLINE void vector_setter(SIMDVector<T,ABI> &vec, const T *data, int idx,
             data[idx+general_stride],data[idx]);
 }
 
-// // 16 word scalar
-// template<typename T, int ABI,
-//          typename std::enable_if<sizeof(T)==16 && internal::get_simd_vector_size<SIMDVector<T,ABI>>::bitsize==64,bool>::type=0>
-// FASTOR_INLINE void vector_setter(SIMDVector<T,ABI> &vec, const T *data, int idx, int general_stride) {
-//     vec.set(data[idx]);
-// }
+// 16 word scalar
+template<typename T, typename ABI,
+         typename std::enable_if<sizeof(T)==16 && internal::get_simd_vector_size<SIMDVector<T,ABI>>::bitsize==64,bool>::type=0>
+FASTOR_INLINE void vector_setter(SIMDVector<T,ABI> &vec, const T *data, int idx, int ) {
+    vec.set(data[idx]);
+}
 // 16 word scalar/SSE
 template<typename T, typename ABI,
          typename std::enable_if<sizeof(T)==16 && internal::get_simd_vector_size<SIMDVector<T,ABI>>::bitsize==128,bool>::type=0>
diff --git a/external/include/Fastor/simd_vector/simd_vector_complex_scalar.h b/external/include/Fastor/simd_vector/simd_vector_complex_scalar.h
index c6fcc99..894bc62 100644
--- a/external/include/Fastor/simd_vector/simd_vector_complex_scalar.h
+++ b/external/include/Fastor/simd_vector/simd_vector_complex_scalar.h
@@ -254,7 +254,7 @@ operator-(U a, const SIMDVector<std::complex<T>,simd_abi::scalar> &b) {
 template <typename T>
 FASTOR_INLINE SIMDVector<std::complex<T>,simd_abi::scalar>
 operator-(const SIMDVector<std::complex<T>,simd_abi::scalar> &b) {
-    return SIMDVector<std::complex<T>,simd_abi::scalar>(0,0) - b;
+    return SIMDVector<std::complex<T>,simd_abi::scalar>(T(0),T(0)) - b;
 }
 
 template <typename T>
